      "items": [
        {
          "info": {
            "name": "Paypal Show details for authorized payment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-m.sandbox.paypal.com/v2/payments/authorizations/:authorization_id",
            "params": [
              {
                "name": "authorization_id",
                "value": "",
                "type": "path",
                "description": "The PayPal-generated ID for the authorized payment to void."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/v1/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Shows details for an authorized payment, by ID."
        },
        {
          "info": {
            "name": "Paypal Capture authorized payment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-m.sandbox.paypal.com/v2/payments/authorizations/:authorization_id/capture",
            "headers": [
              {
                "name": "PayPal-Request-Id",
                "value": ""
              },
              {
                "name": "Prefer",
                "value": ""
              }
