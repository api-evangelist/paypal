{
  "opencollection": "1.0.0",
  "info": {
    "name": "Paypal Subscriptions Authorizations Verify-Webhook-Signature API",
    "version": "1.6"
  },
  "items": [
    {
      "info": {
        "name": "Verify-Webhook-Signature",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Paypal Verify webhook signature",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-m.sandbox.paypal.com/v1/notifications/verify-webhook-signature",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/v1/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Verifies a webhook signature."
        }
      ]
    }
  ],
  "bundled": true
}