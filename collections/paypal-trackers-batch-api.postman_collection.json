      "id": "e7c39dde-6f72-456d-b4d8-f18293d8823a",
      "name": "Trackers-Batch",
      "description": {
        "content": "Use the `/trackers-batch` resource to add tracking information for multiple PayPal transactions.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "da8937e6-6d36-4409-939d-9a5709463f92",
          "name": "Add tracking information for multiple PayPal transactions",
          "request": {
            "name": "Add tracking information for multiple PayPal transactions",
            "description": {
              "content": "Adds tracking information, with or without tracking numbers, for multiple PayPal transactions. Accepts up to 20 tracking IDs. For more information, see <a href=\"/docs/tracking/integrate/#add-tracking-information-with-tracking-numbers\">Add tracking information with tracking numbers</a> and <a href=\"/docs/tracking/integrate/#add-tracking-information-without-tracking-numbers\">Add tracking information without tracking numbers</a>.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "shipping",
                "trackers-batch"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "https://uri.paypal.com/services/subscriptions"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "/v1/oauth2/token"
                },
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trackers\": [\n    {\n      \"transaction_id\": \"<string>\",\n      \"status\": \"<string>\",\n      \"tracking_number\": \"<string>\",\n      \"tracking_number_type\": \"<string>\",\n      \"shipment_date\": \"<ppaas_date_notime_v2>\",\n      \"carrier\": \"<string>\",\n      \"carrier_name_other\": \"<string>\",\n      \"notify_buyer\": false,\n      \"last_updated_time\": \"<ppaas_date_time_v3>\",\n      \"shipment_direction\": \"<string>\",\n      \"tracking_url\": \"<uri>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
